{
  "name": "nh-readiness-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "preinstall": "[ -f .env ] && set -a && . ./.env; set +a; printf '@FO-Enablement-Vivint:registry=https://npm.pkg.github.com\\n' > .npmrc && if [ -n \"$NPM_AUTH_TOKEN\" ]; then printf '//npm.pkg.github.com/:_authToken=%s\\n' \"$NPM_AUTH_TOKEN\" >> .npmrc; fi",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "schema:generate": "tsx --env-file=.env scripts/generate-airtable-schema.ts",
    "auth:check": "tsx --env-file=.env scripts/check-eml-gate.ts",
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "email:match": "tsx --env-file=.env scripts/check-email-match-rate.ts"
  },
  "dependencies": {
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
