# Airtable — New Hire Readiness base. A PAT scoped to this base only.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=app3hcKv9U98zhjNt

# Fillout base URL for the WO Experience form. The pro's record id is appended
# as ?pro=<recId>, matching how the self-assessment link is built in the base.
# Without this the "Log a work order" action renders with no link.
WO_EXPERIENCE_FORM_URL=https://enablement.fillout.com/new_hire_work_order

# Development identity override.
#
# Until Magistrate is wired up, server/lib/session.ts reads the signed-in user
# from this variable instead of a real session. It must be an address that
# appears in Field Ops EML 2.0.WORK_EMAIL or every request returns FORBIDDEN.
#
# This is REFUSED when NODE_ENV=production — see server/lib/session.ts. A
# deployed build with no Magistrate and no override fails closed.
#
# Useful identities (verified 2026-10-22):
#   phillip.daigre@vivint.com   Taylor Daigre — 16 WOs, 2 licences, minimums met
#   tyler.livingston@vivint.com Tyler Livingston — event open, 0 WOs
#   caylen.dozier@vivint.com    Caylen Dozier — no event, 10 outstanding courses
#   mason.boismier@vivint.com   Mason Boismier — Historical
DEV_USER_EMAIL=phillip.daigre@vivint.com

# Alternative to DEV_USER_EMAIL: an EML record id, skipping the email join.
# Wins over DEV_USER_EMAIL when both are set.
#
# Needed because the only pro with fully populated field experience — all 16
# WOs carrying experience areas, person shadowed and participation — is Ivan
# Cervantes, whose WORK_EMAIL is "IVAN.CERVANTES" with no domain. That value is
# Workday-sourced, so fixing it in Airtable would likely be overwritten.
#
#   rec1tjfPVPaCgavl8   Ivan Cervantes — the most complete page available
DEV_USER_RECORD_ID=

# GitHub Packages token, needed to install @FO-Enablement-Vivint/magistrate.
# Not required until the Magistrate step; the preinstall script writes .npmrc
# from it.
NPM_AUTH_TOKEN=
